# Django Settings
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_ALLOWED_ORIGINS=http://localhost:8000
DJANGO_LOG_LEVEL=INFO

# Authentication Allowlist (for Cloud Run IAP/OAuth)
# Comma-separated list of email addresses allowed to access the application
# If not set, all authenticated users are allowed
# DJANGO_ALLOWED_USERS=user1@example.com,user2@example.com

# Database (PostgreSQL for production)
# DJANGO_DB_NAME=giftwiki
# DJANGO_DB_PASS=your-db-password
# DATABASE_PATH=db.sqlite3

# AWS S3 (optional)
# USE_S3=TRUE
# AWS_ACCESS_KEY_ID=your-key
# AWS_SECRET_ACCESS_KEY=your-secret
# AWS_STORAGE_BUCKET_NAME=your-bucket

# Superuser creation (for Docker deployment)
# DJANGO_SUPERUSER_1_USERNAME=admin
# DJANGO_SUPERUSER_1_EMAIL=admin@example.com
# DJANGO_SUPERUSER_1_PASSWORD=secure-password

