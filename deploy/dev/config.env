BASE_DIR=/app
DJANGO_ALLOWED_HOSTS=giftwiki-dev.leetserve.com
DJANGO_ALLOWED_ORIGINS=https://giftwiki-dev.leetserve.com,http://localhost:3000
# Neon PostgreSQL (dev branch) - connection details
