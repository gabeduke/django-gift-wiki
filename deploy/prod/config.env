AWS_S3_REGION_NAME=us-east-1
AWS_STORAGE_BUCKET_NAME=gift-wiki
BASE_DIR=/app
DJANGO_ALLOWED_HOSTS=giftwiki.leetserve.com
DJANGO_ALLOWED_ORIGINS=https://giftwiki.leetserve.com,http://localhost:3000
# Neon PostgreSQL (main/prod branch) - connection details
DJANGO_DB_HOST=ep-falling-morning-ae2u6rxv-pooler.c-2.us-east-2.aws.neon.tech
DJANGO_DB_NAME=neondb
DJANGO_DB_PORT=5432
DJANGO_DB_CONN_MAX_AGE=600
# DJANGO_DB_USER and DJANGO_DB_PASSWORD are set in secrets.env
DJANGO_LOG_LEVEL=DEBUG
USE_S3=TRUE
DJANGO_ENVIRONMENT=prod
FIREBASE_API_KEY=REDACTED

